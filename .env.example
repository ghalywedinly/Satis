# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these per environment (Development / Preview = staging / Production).

# development | staging | production. Staging and production refuse to start with missing values.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain encoded in printed QR codes (defaults to the site URL). Choose it before printing real codes.
NEXT_PUBLIC_SURVEY_BASE_URL=

# Supabase (Project settings → API keys). The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Random string (32+ chars) used to hash visitor IPs for rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Supabase Auth "Send Email" hook secret (Authentication → Hooks), format: v1,whsec_...
AUTH_EMAIL_HOOK_SECRET=

# Transactional email (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Satis <no-reply@example.com>"

# Error monitoring (Sentry). The auth token is only needed in CI to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics (PostHog). Browser events go through /ingest on our own domain.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
